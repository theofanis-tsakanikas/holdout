# Local working notes — never published.
notes/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# uv / virtualenv
.venv/
venv/
uv.lock.bak

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# The AI layer travels with the repository — `.claude/settings.json` and `.claude/hooks/` are
# committed on purpose, so a guarantee is not something that lives on one laptop. The local
# override file is the exception: it is per-machine and per-person by design.
.claude/settings.local.json

# Generated worlds. `corpus/world/` is a pure function of (world, seed, scale), so a world
# is regenerated rather than stored — the opposite of `corpus/real/`, which is committed and
# digest-checked precisely because it cannot be regenerated. `--out .worlds/W6` is the
# convention corpus/world/README.md uses.
.worlds/

# One shard's draws, on the way to whatever combines them. Not the world cache and not keyed
# like one: a world is a pure function of (world, seed, scale), while a draw is the whole
# system run once against a lottery seed. `make claim-2-shard SHARD=i/N` writes here and
# `make claim-2-combine` reads it.
.shards/

# dbt writes both of these **inside its project directory** unless told otherwise, and that
# directory is a tracked package. `pipelines/gold/models.py` passes `--target-path` and
# `--log-path` so they land under a caller-chosen root, and `dbt_project.yml` turns off the
# anonymous usage stats that create `.user.yml` at all. These two lines are the second line of
# defence: this repository is public and a per-machine UUID is not something to rely on one
# flag to keep out.
pipelines/gold/dbt/logs/
pipelines/gold/dbt/target/
pipelines/gold/dbt/.user.yml

# Editors / OS
.DS_Store
.idea/
.vscode/

# Terraform's downloaded providers. **The lock file beside them is tracked and this is not**:
# `.terraform.lock.hcl` is the pin every platform verifies against, and `.terraform/` is 67 MB
# of binary that `terraform init` fetches from it.
infra/**/.terraform/

# Terraform state. **`infra/bootstrap/` keeps its state locally** — it creates the bucket every
# other layer's backend uses, so it cannot store its own state there — and a `terraform.tfstate`
# in a public repository publishes every account id, key arn, role arn and bucket name that
# `infra/bootstrap/*.tf` is written to keep out of the tree. The plan file is here for the same
# reason: `terraform plan -out` writes the same values, in a binary somebody would not think to
# read before committing.
terraform.tfstate
terraform.tfstate.*
*.tfplan
# Variable files are never committed either. `budget_alert_email` is personal data and this is
# where an applier would put it.
*.tfvars
*.tfvars.json
